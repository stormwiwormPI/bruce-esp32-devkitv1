# Auto detect text files and perform LF normalization
* text=auto

# Ensure shell scripts always have Unix LF line endings
*.sh text eol=lf
*.bash text eol=lf

# Windows batch files keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.bin binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff2 binary
